---
// PhoneShowcase.astro
// An iOS home-screen mockup that doubles as the projects section.
// Tap an app icon to open its App Store page (apps) or website (web projects).
//
// --- EDIT ME: each entry below is one project ("app") on the home screen ---
// Fields:
//   name   — label shown under the icon (keep it short, ~12 chars)
//   href   — App Store URL for apps, or the live site for web projects
//   kind   — "app" → button reads "View on App Store"; "web" → "Visit website"
//   blurb  — 1–2 sentences shown in the detail sheet when the icon is tapped
//   glyph  — emoji or 1–2 letters used as the placeholder icon art
//   color  — two CSS colors for the icon's gradient background
//   image  — (optional) path to a real icon, e.g. "/icons/myapp.png".
//            If set, it replaces the gradient + glyph.

interface AppItem {
  name: string;
  href: string;
  kind?: "app" | "web";
  blurb?: string;
  glyph?: string;
  svg?: string; // raw inner SVG for a brand mark (overrides glyph)
  color?: [string, string];
  image?: string;
}

const githubMark =
  '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.37.5 0 5.78 0 12.29c0 5.2 3.44 9.6 8.21 11.16.6.11.82-.25.82-.56 0-.28-.01-1.02-.02-2-3.34.71-4.04-1.58-4.04-1.58-.55-1.37-1.34-1.74-1.34-1.74-1.09-.73.08-.72.08-.72 1.21.08 1.84 1.22 1.84 1.22 1.07 1.8 2.81 1.28 3.5.98.11-.76.42-1.28.76-1.57-2.67-.3-5.47-1.31-5.47-5.83 0-1.29.47-2.34 1.24-3.17-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.21a11.5 11.5 0 0 1 6 0c2.29-1.53 3.3-1.21 3.3-1.21.66 1.66.24 2.88.12 3.18.77.83 1.24 1.88 1.24 3.17 0 4.53-2.81 5.53-5.49 5.82.43.37.81 1.1.81 2.22 0 1.6-.01 2.89-.01 3.28 0 .31.21.68.83.56A12.02 12.02 0 0 0 24 12.29C24 5.78 18.63.5 12 .5z"/></svg>';
const linkedinMark =
  '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/></svg>';

const apps: AppItem[] = [
  { name: "Snifr", href: "https://snifr.ai", kind: "web", blurb: "AI-powered gut health tracking. Quick daily logs turn into personalized insights and a weekly FloraScore. A startup I help build.", glyph: "S", color: ["#f05138", "#b3271a"] },
  { name: "HFX", href: "https://apps.apple.com/us/app/hfx/id6443477068", kind: "app", blurb: "Nevro's companion app for HFX iQ spinal-cord therapy. My work brought it to patients across the EU through internationalization and localization.", image: "/icons/hfx.webp" },
  { name: "Myia", href: "https://myiahealth02.squarespace.com", kind: "web", blurb: "A tablet-based remote patient monitoring system. I led the team that delivered it, pulling data from a range of wearable devices and surfacing it to physicians for better treatment decisions.", image: "/icons/myia.png" },
  { name: "Run Club", href: "https://apps.apple.com/us/app/nike-run-club-running-coach/id387771637", kind: "app", blurb: "Nike's running coach and community app. I worked on the community experiences, making sure the right metrics were captured and used to give runners their best experience.", image: "/icons/nike-run-club.webp" },
  { name: "Monovo", href: "https://apps.apple.com/us/app/monovo/id1508030721", kind: "app", blurb: "A connected health-monitoring app I built from the ground up, starting with their proprietary heart rate monitor and expanding to additional devices including blood pressure and pulse oximetry.", image: "/icons/monovo.webp" },
  { name: "Skip", href: "https://getskip.com", kind: "web", blurb: "A scan-and-go shopping app. I contributed to the Android checkout experience, letting shoppers buy and go without waiting for a cashier.", image: "/icons/skip.png" },
  { name: "Base Tag", href: "#", kind: "app", blurb: "A game that gets people outside and active, using custom hardware to make play more interesting.", glyph: "⚑", color: ["#ff7a1a", "#d2530a"] },
  { name: "字典", href: "#", kind: "app", blurb: "A personal project from my college Chinese course. Instead of keeping a paper list of characters, I built a digital dictionary: a browsable list where each entry opens its character, pronunciation, definition, and examples, with add and remove built in.", glyph: "字", color: ["#c8102e", "#8a0a20"] },
  { name: "MultiLing", href: "#", kind: "app", blurb: "A C++ command-line tool that pulls the translatable text out of DNA sequence listings. It turned a job that took me seven hours by hand into one that finishes in under a second.", image: "/icons/multiling.png" },
];

// --- The dock: your links as "system apps" ---
const dock: AppItem[] = [
  { name: "GitHub", href: "https://github.com/adamqure", svg: githubMark, color: ["#3a3a3c", "#1c1c1e"] },
  { name: "LinkedIn", href: "https://www.linkedin.com/in/adamqure", svg: linkedinMark, color: ["#0a66c2", "#074a8e"] },
];

function isExternal(href: string) {
  return href.startsWith("http");
}
---

<div class="stage">
  <div class="glow" aria-hidden="true"></div>
  <div class="phone-tilt">
  <div class="phone" role="region" aria-label="Projects, shown as an iPhone home screen">
    <!-- titanium side buttons -->
    <span class="btn action" aria-hidden="true"></span>
    <span class="btn vol-up" aria-hidden="true"></span>
    <span class="btn vol-down" aria-hidden="true"></span>
    <span class="btn power" aria-hidden="true"></span>

    <div class="screen">
      <!-- status bar -->
      <div class="statusbar">
        <span class="time">9:41</span>
        <span class="island" aria-hidden="true"></span>
        <span class="indicators" aria-hidden="true">
          <svg viewBox="0 0 16 12" class="ind wifi"><path d="M8 11.2 1 4.2a9.5 9.5 0 0 1 14 0L8 11.2Z" fill="currentColor"/></svg>
          <svg viewBox="0 0 27 13" class="ind battery">
            <rect x="0.6" y="1.4" width="22" height="10.2" rx="3" fill="none" stroke="currentColor" stroke-width="1" opacity="0.5"/>
            <rect x="2.1" y="2.9" width="17" height="7.2" rx="1.7" fill="currentColor"/>
            <path d="M24.4 4.4c0.7 0 1.2 0.6 1.2 1.4v1.4c0 0.8-0.5 1.4-1.2 1.4Z" fill="currentColor" opacity="0.5"/>
          </svg>
        </span>
      </div>

      <!-- home screen grid -->
      <div class="grid">
        {
          apps.map((app, i) => (
            <a
              class="app"
              style={`--i:${i}`}
              href={app.href}
              aria-label={`Open ${app.name}`}
              data-sheet
              data-name={app.name}
              data-kind={app.kind ?? "web"}
              data-blurb={app.blurb ?? ""}
              data-glyph={app.glyph ?? ""}
              data-image={app.image ?? ""}
              data-c1={app.color?.[0] ?? "#3a3a3c"}
              data-c2={app.color?.[1] ?? "#1c1c1e"}
              target={isExternal(app.href) ? "_blank" : undefined}
              rel={isExternal(app.href) ? "noopener noreferrer" : undefined}
            >
              <span
                class="icon"
                style={
                  app.image
                    ? `background-image:url(${app.image});background-size:cover`
                    : `background-image:linear-gradient(160deg, ${app.color?.[0]}, ${app.color?.[1]})`
                }
              >
                {app.image ? null : app.svg ? (
                  <span class="mark" set:html={app.svg} />
                ) : (
                  <span class="glyph">{app.glyph}</span>
                )}
              </span>
              <span class="label">{app.name}</span>
            </a>
          ))
        }
      </div>

      <!-- dock -->
      <div class="dock">
        {
          dock.map((app) => (
            <a
              class="app dockapp"
              href={app.href}
              aria-label={`Open ${app.name}`}
              target={isExternal(app.href) ? "_blank" : undefined}
              rel={isExternal(app.href) ? "noopener noreferrer" : undefined}
            >
              <span
                class="icon"
                style={
                  app.image
                    ? `background-image:url(${app.image});background-size:cover`
                    : `background-image:linear-gradient(160deg, ${app.color?.[0]}, ${app.color?.[1]})`
                }
              >
                {app.image ? null : app.svg ? (
                  <span class="mark" set:html={app.svg} />
                ) : (
                  <span class="glyph">{app.glyph}</span>
                )}
              </span>
            </a>
          ))
        }
      </div>

      <!-- app detail bottom sheet (pointer-events:none when closed) -->
      <div class="sheet-host" data-host>
        <div class="scrim" data-scrim></div>
        <div class="sheet" data-sheet-panel role="dialog" aria-modal="true" aria-hidden="true">
          <span class="grabber" aria-hidden="true"></span>
          <div class="sheet-head">
            <span class="sheet-icon" data-sheet-icon></span>
            <div class="sheet-meta">
              <span class="sheet-name" data-sheet-name></span>
              <span class="sheet-kind" data-sheet-kind></span>
            </div>
          </div>
          <p class="sheet-blurb" data-sheet-blurb></p>
          <a class="sheet-open" data-sheet-open target="_blank" rel="noopener noreferrer">Open</a>
        </div>
      </div>
    </div>
  </div>
  </div>

  <p class="hint">Tap an app to learn more about it.</p>
</div>

<style>
  .stage {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.9rem;
    perspective: 1100px;
  }

  /* brand glow halo behind the phone */
  .glow {
    position: absolute;
    top: 46%;
    left: 50%;
    width: 360px;
    height: 360px;
    max-width: 90%;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(45, 107, 255, 0.42),
      rgba(21, 194, 163, 0.16) 48%,
      transparent 72%
    );
    filter: blur(10px);
    z-index: 0;
    pointer-events: none;
  }

  /* subtle 3D tilt that levels when you interact */
  .phone-tilt {
    position: relative;
    z-index: 1;
    transform: rotateY(-7deg) rotateX(3deg);
    transition: transform 0.6s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .stage:hover .phone-tilt,
  .phone-tilt:focus-within {
    transform: rotateY(0deg) rotateX(0deg);
  }

  .phone {
    position: relative;
    width: 300px;
    max-width: 84vw;
    aspect-ratio: 300 / 612;
    border-radius: 55px;
    padding: 6px;
    animation: float 6s ease-in-out infinite;
    /* titanium rail: bright edges, darker faces */
    background:
      linear-gradient(150deg, #3a3c42 0%, #16171a 18%, #2c2e33 50%, #131416 82%, #303237 100%);
    box-shadow:
      0 0 0 1.5px #000,
      0 0 0 3px #45474d,
      0 0 0 4px #15161a,
      0 30px 60px -20px rgba(0, 0, 0, 0.75),
      inset 0 1px 2px rgba(255, 255, 255, 0.15);
  }

  /* side buttons */
  .btn {
    position: absolute;
    background: linear-gradient(90deg, #1a1b1e, #3a3c42, #1a1b1e);
    border-radius: 2px;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.4);
  }
  .btn.action {
    left: -3px;
    top: 96px;
    width: 3px;
    height: 30px;
  }
  .btn.vol-up {
    left: -3px;
    top: 144px;
    width: 3px;
    height: 46px;
  }
  .btn.vol-down {
    left: -3px;
    top: 200px;
    width: 3px;
    height: 46px;
  }
  .btn.power {
    right: -3px;
    top: 168px;
    width: 3px;
    height: 64px;
  }

  .screen {
    position: relative;
    height: 100%;
    border-radius: 49px;
    overflow: hidden;
    /* light, flowing pastel wallpaper (original — evokes iOS 18) */
    background:
      radial-gradient(
        115% 85% at 12% 6%,
        #f8ccc4 0%,
        #f0a7a9 32%,
        rgba(240, 167, 169, 0) 60%
      ),
      radial-gradient(
        120% 115% at 102% 58%,
        #7fb6c6 0%,
        #3f8197 38%,
        rgba(63, 129, 151, 0) 66%
      ),
      linear-gradient(
        178deg,
        #f3b9b2 0%,
        #e6a0a0 22%,
        #b6909e 42%,
        #5b8597 62%,
        #28526a 82%,
        #15303f 100%
      );
    display: flex;
    flex-direction: column;
  }

  .statusbar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 46px;
    padding: 0 1.5rem;
    /* dark text: top of the wallpaper is light */
    color: #15171a;
    font-size: 0.82rem;
    font-weight: 600;
  }

  .time {
    padding-left: 0.15rem;
    letter-spacing: 0.02em;
  }

  .indicators {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .ind.wifi {
    height: 11px;
  }
  .ind.battery {
    height: 12px;
  }

  .island {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 84px;
    height: 25px;
    background: #000;
    border-radius: 14px;
  }

  .ind {
    width: auto;
    fill: currentColor;
  }

  .grid {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    align-content: start;
    gap: 0.5rem 0.3rem;
    padding: 1.1rem 0.9rem 0.5rem;
  }

  .app {
    display: grid;
    justify-items: center;
    gap: 0.32rem;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  .icon {
    width: 52px;
    height: 52px;
    border-radius: 13px;
    display: grid;
    place-items: center;
    background-color: #333;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.25),
      0 4px 10px -3px rgba(0, 0, 0, 0.6);
    transition:
      opacity 0.45s ease calc(var(--i, 0) * 0.045s),
      scale 0.5s cubic-bezier(0.2, 0.8, 0.3, 1.4) calc(var(--i, 0) * 0.045s),
      transform 0.12s ease,
      filter 0.12s ease;
  }

  /* staggered spring-in (JS adds .reveal then .in) */
  .grid.reveal .app .icon {
    opacity: 0;
    scale: 0.6;
  }
  .grid.reveal.in .app .icon {
    opacity: 1;
    scale: 1;
  }

  .app:hover .icon {
    filter: brightness(1.08);
    transform: translateY(-3px);
  }
  .app:active .icon {
    transform: scale(0.92);
  }

  .glyph {
    font-size: 1.45rem;
    line-height: 1;
    color: #fff;
    font-weight: 600;
  }

  .mark {
    display: grid;
    place-items: center;
    color: #fff;
  }
  .mark :global(svg) {
    width: 58%;
    height: 58%;
  }

  .label {
    font-size: 0.66rem;
    color: rgba(255, 255, 255, 0.92);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
    max-width: 60px;
    text-align: center;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .dock {
    margin: 0 0.7rem 0.9rem;
    padding: 0.55rem;
    display: flex;
    justify-content: center;
    gap: 0.65rem;
    background: rgba(255, 255, 255, 0.22);
    border-radius: 30px;
    border: 0.5px solid rgba(255, 255, 255, 0.22);
    box-shadow: inset 0 0.5px 0 rgba(255, 255, 255, 0.3);
    backdrop-filter: blur(22px) saturate(1.4);
    -webkit-backdrop-filter: blur(22px) saturate(1.4);
  }

  .hint {
    margin: 0;
    color: var(--muted);
    font-size: 0.85rem;
  }

  /* bottom sheet — host is pointer-transparent when closed,
     so the app icons stay tappable after dismissing */
  .sheet-host {
    position: absolute;
    inset: 0;
    z-index: 5;
    pointer-events: none;
  }
  .sheet-host.open {
    pointer-events: auto;
  }

  .scrim {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.32);
    opacity: 0;
    transition: opacity 0.28s ease;
  }
  .sheet-host.open .scrim {
    opacity: 1;
  }

  .sheet {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0.7rem 1.25rem 1.4rem;
    background: rgba(244, 244, 247, 0.86);
    backdrop-filter: blur(28px) saturate(1.6);
    -webkit-backdrop-filter: blur(28px) saturate(1.6);
    border-radius: 30px 30px 49px 49px;
    box-shadow: 0 -12px 30px -10px rgba(0, 0, 0, 0.4);
    color: #15171a;
    transform: translateY(110%);
    transition: transform 0.32s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .sheet-host.open .sheet {
    transform: translateY(0);
  }

  .grabber {
    display: block;
    width: 38px;
    height: 5px;
    margin: 0 auto 0.85rem;
    border-radius: 3px;
    background: rgba(60, 60, 67, 0.3);
  }

  .sheet-head {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 0.85rem;
  }
  .sheet-icon {
    width: 56px;
    height: 56px;
    border-radius: 13px;
    display: grid;
    place-items: center;
    font-size: 1.6rem;
    font-weight: 500;
    color: #fff;
    background-size: cover;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.25);
    flex: none;
  }
  .sheet-meta {
    display: grid;
    gap: 0.1rem;
  }
  .sheet-name {
    font-size: 1.15rem;
    font-weight: 600;
  }
  .sheet-kind {
    font-size: 0.78rem;
    color: rgba(60, 60, 67, 0.6);
  }
  .sheet-blurb {
    margin: 0 0 1.1rem;
    font-size: 0.92rem;
    line-height: 1.5;
    color: rgba(30, 30, 35, 0.85);
  }
  .sheet-open {
    display: block;
    text-align: center;
    padding: 0.65rem;
    border-radius: 14px;
    background: #0a84ff;
    color: #fff;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
  }
  .sheet-open:hover {
    background: #0a78e6;
    text-decoration: none;
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-9px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .phone {
      animation: none;
    }
    .phone-tilt {
      transform: none;
      transition: none;
    }
    .icon,
    .sheet,
    .scrim {
      transition: none;
    }
    .grid.reveal .app .icon {
      opacity: 1;
      scale: 1;
    }
  }
</style>

<script>
  const host = document.querySelector<HTMLElement>("[data-host]");
  const scrim = document.querySelector<HTMLElement>("[data-scrim]");
  const panel = document.querySelector<HTMLElement>("[data-sheet-panel]");
  const sIcon = document.querySelector<HTMLElement>("[data-sheet-icon]");
  const sName = document.querySelector<HTMLElement>("[data-sheet-name]");
  const sKind = document.querySelector<HTMLElement>("[data-sheet-kind]");
  const sBlurb = document.querySelector<HTMLElement>("[data-sheet-blurb]");
  const sOpen = document.querySelector<HTMLAnchorElement>("[data-sheet-open]");

  function openSheet(a: HTMLElement) {
    if (!host || !panel || !sIcon || !sName || !sKind || !sBlurb || !sOpen) return;
    const d = a.dataset;
    const href = a.getAttribute("href") || "#";

    if (d.image) {
      sIcon.style.backgroundImage = `url(${d.image})`;
      sIcon.textContent = "";
    } else {
      sIcon.style.backgroundImage = `linear-gradient(160deg, ${d.c1}, ${d.c2})`;
      sIcon.textContent = d.glyph || "";
    }
    sName.textContent = d.name || "";
    sKind.textContent = d.kind === "app" ? "App" : "Website";
    sBlurb.textContent = d.blurb || "";
    if (!href || href === "#") {
      sOpen.style.display = "none";
    } else {
      sOpen.style.display = "";
      sOpen.textContent = d.kind === "app" ? "View on App Store" : "Visit website";
      sOpen.href = href;
      const external = href.startsWith("http");
      if (external) {
        sOpen.target = "_blank";
        sOpen.rel = "noopener noreferrer";
      } else {
        sOpen.removeAttribute("target");
        sOpen.removeAttribute("rel");
      }
    }

    host.classList.add("open");
    panel.setAttribute("aria-hidden", "false");
  }

  function closeSheet() {
    if (!host || !panel) return;
    host.classList.remove("open");
    panel.setAttribute("aria-hidden", "true");
  }

  document.querySelectorAll<HTMLElement>(".grid .app[data-sheet]").forEach((a) => {
    a.addEventListener("click", (e) => {
      e.preventDefault();
      openSheet(a);
    });
  });

  scrim?.addEventListener("click", closeSheet);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeSheet();
  });

  // staggered spring-in for the home-screen icons
  const grid = document.querySelector<HTMLElement>(".grid");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (grid && !reduce) {
    grid.classList.add("reveal");
    requestAnimationFrame(() =>
      requestAnimationFrame(() => grid.classList.add("in"))
    );
  }
</script>
