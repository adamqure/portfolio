---
import Layout from "../layouts/Layout.astro";
import PhoneShowcase from "../components/PhoneShowcase.astro";

// --- DRAFT COPY — written from your brand (Ship quality. Predictably.) ---
// Tweak anything in brackets or that doesn't sound like you. Projects ("apps")
// live in src/components/PhoneShowcase.astro. Your photo: public/portrait.jpg.

// Skill chips under the hero — CONFIRM these against your LinkedIn skills.
const skills = [
  "Test-Driven Development",
  "Software Architecture",
  "Continuous Delivery",
  "Technical Mentorship",
];

const ctas = [
  {
    title: "Contract work",
    blurb:
      "I help teams ship quality software on a predictable cadence, with architecture, testing, and delivery that holds up.",
    label: "Start a conversation",
    href: "mailto:hello@apace.studio?subject=Contract%20work",
  },
  {
    title: "Speaking",
    blurb:
      "Talks on quality engineering, automated testing, and predictable delivery. Happy to tailor a session for your event or team.",
    label: "Invite me to speak",
    href: "mailto:speaking@apace.studio?subject=Speaking%20engagement",
  },
  {
    title: "Mentorship",
    blurb:
      "I work with a small number of engineers who want to level up how they build and ship. Reach out if that's you.",
    label: "Ask about mentorship",
    href: "mailto:hello@apace.studio?subject=Mentorship",
  },
];

const links = [
  { label: "Email", href: "mailto:hello@apace.studio" },
  { label: "GitHub", href: "https://github.com/adamqure" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/adamqure" },
  { label: "snifr.ai", href: "https://snifr.ai" },
];
---

<Layout>
  <header class="hero">
    <div class="hero-copy">
      <div class="identity">
        <img
          class="avatar"
          src="/portrait.jpg"
          width="48"
          height="48"
          alt="Adam Ure"
          loading="eager"
        />
        <div>
          <p class="name">Adam Ure</p>
          <p class="role">Principal engineer &amp; mobile architect</p>
        </div>
      </div>

      <h1>Ship quality.<br /><span class="accent">Predictably.</span></h1>
      <p class="lede">
        I help teams build software that's a pleasure to use and dependable to
        ship, pairing strong engineering with a delivery cadence you can plan
        around.
      </p>
      <div class="actions">
        <a class="btn primary" href="mailto:hello@apace.studio?subject=Let's%20work%20together"
          >Work with me</a
        >
        <a class="btn ghost" href="#work-with-me">See how I help</a>
      </div>
      <ul class="skills" aria-label="Focus areas">
        {skills.map((k) => <li>{k}</li>)}
      </ul>
    </div>

    <div class="hero-phone">
      <PhoneShowcase />
    </div>
  </header>

  <section class="about" data-reveal>
    <div class="about-photo">
      <img
        src="/portrait.jpg"
        width="320"
        height="400"
        alt="Adam Ure"
        loading="lazy"
      />
    </div>
    <div class="about-text">
      <h2>About</h2>
      <p class="prose">
        I build quality into software rather than bolting it on afterward. Most
        recently I've been working in regulated medical software (SaMD), where
        "it works on my machine" isn't good enough, and I care as much about the
        teams shipping the software as the software itself.
      </p>
      <p class="prose">
        Outside the day job I write and speak about testing, quality, and
        predictable delivery, and mentor engineers who want to grow. Away from
        the keyboard I'm a dad of three, a singer, and a lifelong student of
        Mandarin. I bring the same curiosity and discipline to a new language or
        song as I do to building software, and I'm always up for a good game.
      </p>
    </div>
  </section>

  <section id="work-with-me" data-reveal>
    <h2>Work with me</h2>
    <div class="ctas">
      {
        ctas.map((c) => (
          <div class="cta">
            <h3>{c.title}</h3>
            <p>{c.blurb}</p>
            <a href={c.href}>{c.label} →</a>
          </div>
        ))
      }
    </div>
  </section>

  <section class="contact" data-reveal>
    <h2>Let's talk</h2>
    <p class="prose">
      Whether you're scoping a project, planning an event, considering working
      together one-on-one, or just have a question about shipping quality
      software, I'd love to hear from you. No pitch required, and no question is
      too small.
    </p>
    <p class="prose">
      Email is the best way to reach me. I read every message and aim to reply
      within a couple of days.
    </p>
    <a class="btn primary" href="mailto:hello@apace.studio?subject=Hello">Email me</a>
    <p class="contact-addr">hello@apace.studio</p>
  </section>

  <footer>
    <p class="links">
      {
        links.map((l, i) => (
          <>
            <a href={l.href}>{l.label}</a>
            {i < links.length - 1 && <span class="sep"> · </span>}
          </>
        ))
      }
    </p>
    <p>© {new Date().getFullYear()} Adam Ure</p>
  </footer>
</Layout>

<style>
  /* --- split hero --- */
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: center;
    margin: 1rem 0 0;
  }

  .identity {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }
  .avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 22%;
    border: 1.5px solid var(--border);
  }
  .name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1rem;
    color: var(--fg);
  }
  .role {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--teal);
  }

  h1 {
    font-size: clamp(2.5rem, 6vw, 4.75rem);
    font-weight: 700;
    line-height: 1.02;
    margin: 0 0 1.5rem;
  }
  h1 .accent {
    position: relative;
    color: var(--teal);
  }
  h1 .accent::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.12em;
    height: 3px;
    border-radius: 2px;
    background: var(--teal);
    opacity: 0.5;
  }

  .lede {
    color: var(--muted);
    font-size: clamp(1.1rem, 1.5vw, 1.4rem);
    line-height: 1.65;
    margin: 0 0 2.25rem;
    max-width: 46rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .btn {
    display: inline-block;
    padding: 0.75rem 1.4rem;
    border-radius: 11px;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    transition: transform 0.15s ease, filter 0.15s ease, background 0.15s ease;
  }
  .btn:hover {
    text-decoration: none;
  }
  .btn.primary {
    background: var(--accent);
    color: #fff;
    box-shadow: 0 10px 24px -8px rgba(45, 107, 255, 0.6);
  }
  .btn.primary:hover {
    filter: brightness(1.1);
    transform: translateY(-2px);
  }
  .btn.ghost {
    color: var(--fg);
    border: 1px solid var(--border);
  }
  .btn.ghost:hover {
    background: var(--surface);
    transform: translateY(-2px);
  }

  .skills {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding: 0;
    margin: 2.5rem 0 0;
  }
  .skills li {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted);
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 999px;
  }

  .hero-phone {
    display: flex;
    justify-content: center;
  }

  /* --- about (photo + text) --- */
  .about {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 3rem;
    align-items: center;
  }
  .about-photo img {
    width: 220px;
    height: 280px;
    object-fit: cover;
    object-position: center 18%;
    border-radius: 18px;
    border: 1px solid var(--border);
    box-shadow: 0 18px 40px -20px rgba(0, 0, 0, 0.7);
  }
  .about-text {
    min-width: 0;
  }

  /* --- shared sections (divider sits centered in the gap) --- */
  section {
    margin: 5.5rem 0 0;
    padding-top: 5.5rem;
    border-top: 1px solid var(--border);
  }

  h2 {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--muted);
    margin: 0 0 1.5rem;
  }

  .prose {
    margin: 0 0 1.15rem;
    max-width: 38rem;
    line-height: 1.7;
  }

  .ctas {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }

  .cta {
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 1.6rem;
    background: var(--surface);
    transition: transform 0.15s ease, border-color 0.15s ease;
  }
  .cta:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
  }
  .cta h3 {
    margin: 0 0 0.5rem;
    font-size: 1.1rem;
    font-weight: 600;
  }
  .cta p {
    margin: 0 0 1.1rem;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .cta a {
    font-weight: 700;
  }

  .contact .btn {
    margin-top: 0.5rem;
  }
  .contact-addr {
    margin: 0.9rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--muted);
  }

  .links {
    margin: 0 0 0.5rem;
  }
  .links .sep {
    color: var(--muted);
  }

  footer {
    margin-top: 5.5rem;
    padding-top: 5.5rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.85rem;
  }

  /* --- scroll reveal --- */
  [data-reveal] {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 0.6s ease,
      transform 0.6s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  [data-reveal].revealed {
    opacity: 1;
    transform: none;
  }

  /* --- responsive --- */
  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      justify-items: start;
    }
    /* phone sits under the tagline copy on small screens */
    .hero-phone {
      order: 1;
      justify-content: flex-start;
    }
    section {
      margin: 4rem 0 0;
      padding-top: 4rem;
    }
    .about {
      grid-template-columns: 1fr;
      gap: 1.75rem;
      justify-items: start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .btn,
    .cta {
      transition: none;
    }
  }
</style>

<script>
  const els = document.querySelectorAll("[data-reveal]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (reduce || !("IntersectionObserver" in window)) {
    els.forEach((el) => el.classList.add("revealed"));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add("revealed");
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.12 }
    );
    els.forEach((el) => io.observe(el));
  }
</script>
